{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/protect-files.cjs\"", "timeout": 10}]
      },
      {
        "matcher": "Read",
        "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/secret-read.cjs\"", "timeout": 10}]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [{"type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.cjs\"", "timeout": 10}]
      }
    ]
  }
}
