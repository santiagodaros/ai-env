{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Veredicto del auditor",
  "type": "object",
  "additionalProperties": false,
  "required": ["pr", "verdict", "summary", "findings", "checks", "tests_honest"],
  "properties": {
    "pr": { "type": "integer", "minimum": 1 },
    "verdict": { "type": "string", "enum": ["aprobar", "cambios", "bloquear"] },
    "summary": { "type": "string", "minLength": 20, "maxLength": 800 },
    "tests_honest": { "type": "string", "enum": ["si", "no", "no-verificado"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["severity", "area", "where", "issue", "fix"],
        "properties": {
          "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "area": { "type": "string", "enum": ["esquema", "inyeccion", "timeout", "tests", "seguridad", "contrato", "alcance", "otro"] },
          "where": { "type": "string", "minLength": 2 },
          "issue": { "type": "string", "minLength": 5 },
          "fix": { "type": "string", "minLength": 5 }
        }
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "result"],
        "properties": {
          "name": { "type": "string" },
          "result": { "type": "string", "enum": ["pasa", "falla", "no-aplica", "no-verificado"] },
          "detail": { "type": "string" }
        }
      }
    }
  }
}
